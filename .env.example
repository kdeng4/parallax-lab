# Reference for local shell configuration; export overrides before startup.
# scripts/dev.py does not load .env. Compose defines its own internal defaults
# in compose.yaml; copying this file to .env does not override those values.
API_BASE_URL=http://127.0.0.1:8000
PARALLAX_DATABASE_URL=sqlite:///./.data/parallax-lab.db
# Empty workspaces by default; demo seeding is only available outside Vercel.
PARALLAX_SEED_DEMO=0
# Explicit local-only write permission (scripts/dev.py supplies this).
PARALLAX_LOCAL_WRITE_ACCESS=1
# Real market history and indicators. Sensitive, server-only; production only.
# TIINGO_API_KEY=
# External reads default on only in Vercel Production, off in preview/local.
# Export this locally to use actual providers:
# PARALLAX_MARKET_NETWORK=1
# Optional deterministic fixtures ONLY for isolated local testing; ignored on Vercel:
# PARALLAX_MARKET_SOURCE=synthetic
# Optional AI provider adapter credentials; replay uses local baselines.
# Never put credentials in NEXT_PUBLIC_* variables or commit your .env.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Hosted runtime: use distinct Neon pooled URLs and tokens per environment.
# PARALLAX_DATABASE_URL=postgresql://...
# PARALLAX_API_TOKEN=
# Managed Neon Auth; configure a GitHub OAuth app and disable other auth methods.
# NEON_AUTH_BASE_URL=https://your-branch.neonauth.region.aws.neon.tech/parallax/auth
# NEON_AUTH_COOKIE_SECRET=
# NEON_AUTH_GITHUB_READY=0
# The owner's immutable numeric GitHub user ID, not their login or email.
# PARALLAX_OWNER_GITHUB_ID=49372435
# Migration only: direct owner connection, never a frontend variable.
# PARALLAX_DATABASE_URL_UNPOOLED=postgresql://...
# Isolated test database only; enables PostgreSQL integration tests.
# PARALLAX_TEST_DATABASE_URL=postgresql://...

# Private news and event sources. Credentials remain server-only.
# MARKETAUX_API_KEY=
# ALPHA_VANTAGE_API_KEY=
# FRED_API_KEY=
# PARALLAX_SEC_USER_AGENT=Parallax Lab (contact: owner@example.com)
# Licence assertions, not purchases or grants of data rights. Leave 0 until verified.
PARALLAX_TIINGO_STORAGE_APPROVED=0
PARALLAX_PUBLIC_PERFORMANCE_APPROVED=0
