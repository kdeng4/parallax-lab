# Reference for local shell configuration; export overrides before startup.
# scripts/dev.py does not load .env. Compose defines its own internal defaults
# in compose.yaml; copying this file to .env does not override those values.
API_BASE_URL=http://127.0.0.1:8000
PARALLAX_DATABASE_URL=sqlite:///./.data/parallax-lab.db
# Optional provider adapter credentials; milestone 1 replay uses local baselines.
# Never put credentials in NEXT_PUBLIC_* variables or commit your .env.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Hosted runtime: use distinct Neon pooled URLs and tokens per environment.
# PARALLAX_DATABASE_URL=postgresql://...
# PARALLAX_API_TOKEN=
# Migration only: direct owner connection, never a frontend variable.
# PARALLAX_DATABASE_URL_UNPOOLED=postgresql://...
# Isolated test database only; enables PostgreSQL integration tests.
# PARALLAX_TEST_DATABASE_URL=postgresql://...
