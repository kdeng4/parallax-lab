{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "installCommand": "npm ci",
      "buildCommand": "npm run build",
      "bindings": [
        { "type": "service", "service": "api", "format": "url", "env": "BACKEND_INTERNAL_URL" }
      ]
    },
    "api": {
      "root": "apps/api",
      "framework": "fastapi",
      "entrypoint": "parallax_lab.main:app"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
